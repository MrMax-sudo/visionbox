# VisionBox — .env.example
# Copie para .env (não commitar .env) e ajuste conforme seu ambiente local.
# Todos os valores abaixo são DEV-ONLY — produção vem de Vault/KMS/Secrets Manager.

# ── App ──
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL 15 ──
POSTGRES_DB=visionbox
POSTGRES_USER=visionbox
POSTGRES_PASSWORD=visionbox_dev_2026
POSTGRES_PORT=5432

# ── Redis 7 ──
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_2026

# ── RabbitMQ 3.13 ──
RABBITMQ_USER=visionbox
RABBITMQ_PASSWORD=visionbox_dev_2026
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── MinIO / S3 ──
MINIO_ROOT_USER=visionbox
MINIO_ROOT_PASSWORD=visionbox_dev_2026_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=visionbox-dev
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_REGION=us-east-1

# ── Segurança / JWT ──
JWT_SECRET=dev_jwt_secret_change_in_prod_32chars_min__CHANGE_ME
# KEK 256-bit hex (32 bytes) — dev only. Prod: Vault transit/KMS, nunca em .env
CRYPTO_KEK_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
CRYPTO_HMAC_PEPPER=dev_hmac_pepper_change_in_prod__CHANGE_ME

# ── Observabilidade ──
# Grafana/Prometheus não estão no compose dev por padrão; adicione se precisar

# ── Cloudflare Tunnel (Acesso Externo) ──
# Obtenha o token em: Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJh...seu_token_aqui

