# VisionBox Web — variáveis de ambiente
# Copie para .env.local e ajuste conforme ambiente

# URL base da API — em dev use /api (proxy do Vite → localhost:8080)
# Em produção aponte para o gateway real (ex: https://api.visionbox.com.br)
VITE_API_URL=/api

# Opcional: timeout em ms para apiClient
# VITE_API_TIMEOUT=15000
